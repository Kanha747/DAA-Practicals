// Implement prim’s algorithm. 
// Properties of Spanning Tree
// connected, weighted, undirected,no loops, no cycles, no parallel edges.

#include <iostream>
#include <climits>
using namespace std;

void prims(int graph[10][10], int n) {
    bool visited[10] = {false};
    int key[10];
    int parent[10];

    for (int i = 0; i < n; i++) {
        key[i] = INT_MAX;
        parent[i] = -1;
    }

    key[0] = 0;   // Start from vertex 0
    int total_cost = 0;

    for (int count = 0; count < n; count++) {
        int minimum = INT_MAX;
        int u = -1;

        for (int i = 0; i < n; i++) {
            if (!visited[i] && key[i] < minimum) {
                minimum = key[i];
                u = i;
            }
        }

        if (u == -1) {
            break;   // graph disconnected
        }

        visited[u] = true;
        total_cost += key[u];

        cout << "Edge " << parent[u] << " - " << u
             << " : weight " << key[u] << endl;

        for (int v = 0; v < n; v++) {
            if (!visited[v] && graph[u][v] != 0 && graph[u][v] < key[v]) {
                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    cout << "Total MST cost = " << total_cost << endl;
}

int main() {
    int n;
    int graph[10][10];

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> graph[i][j];
        }
    }

    prims(graph, n);
    return 0;
}
