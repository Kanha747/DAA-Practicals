// Implement Kruskal's algorithm.
#include <algorithm>
#include <iostream>
#include <numeric>
#include <vector>

using namespace std;

struct Edge {
    int u;
    int v;
    int weight;
};

int find(vector<int>& parent, int vertex) {
    if (parent[vertex] != vertex) {
        parent[vertex] = find(parent, parent[vertex]);
    }
    return parent[vertex];
}

bool unite(vector<int>& parent, vector<int>& rank, int u, int v) {
    u = find(parent, u);
    v = find(parent, v);
    if (u == v) {
        return false;
    }

    if (rank[u] < rank[v]) {
        swap(u, v);
    }
    parent[v] = u;
    if (rank[u] == rank[v]) {
        ++rank[u];
    }
    return true;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<Edge> edges(m);
    for (Edge& edge : edges) {
        cin >> edge.u >> edge.v >> edge.weight;
    }

    sort(edges.begin(), edges.end(), [](const Edge& a, const Edge& b) {
        return a.weight < b.weight;
    });

    vector<int> parent(n);
    vector<int> rank(n, 0);
    iota(parent.begin(), parent.end(), 0);

    vector<Edge> mst;
    int totalCost = 0;
    for (const Edge& edge : edges) {
        if (unite(parent, rank, edge.u, edge.v)) {
            mst.push_back(edge);
            totalCost += edge.weight;
            if (static_cast<int>(mst.size()) == n - 1) {
                break;
            }
        }
    }

    if (static_cast<int>(mst.size()) != n - 1) {
        cout << "A spanning tree does not exist.\n";
        return 0;
    }

    cout << "Edges in the minimum spanning tree:\n";
    for (const Edge& edge : mst) {
        cout << edge.u << " - " << edge.v << " : " << edge.weight << '\n';
    }
    cout << "Total cost: " << totalCost << '\n';
    return 0;
}
